# ==============================================================================
# Research Toolkit Environment Configuration
# Copy this file to .env and populate your secrets.
# ==============================================================================

# --- Literature Discovery APIs ---
# Semantic Scholar API key (grants dedicated 1 RPS; leave empty for public pool)
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex API key (free registered developer key; grants up to 100 RPS)
OPENALEX_API_KEY=

# --- Zotero Integration (Personal Library) ---
# Your Zotero Web API Key (create at https://www.zotero.org/settings/keys with Read/Write permissions)
ZOTERO_API_KEY=

# Your personal numerical Zotero User ID (found at https://www.zotero.org/settings/keys)
ZOTERO_USER_ID=

# Zotero library type: strictly 'user' (personal library)
ZOTERO_LIBRARY_TYPE=user

# Optional local storage path if mounting Zotero attachments inside Docker / on desktop
ZOTERO_STORAGE_DIR=/app/data/zotero_storage

# --- Google NotebookLM Gateway ---
# Serialized JSON authentication profile or session cookies
# Generated via `notebooklm login` or exported from browser
NOTEBOOKLM_AUTH_JSON=

# Backend mode: 'web' (cookie-based) or 'android' (master token)
NOTEBOOKLM_BACKEND=web

# Optional official Google Gemini API Key (used as resilient fallback if reverse-engineered RPC shifts)
GEMINI_API_KEY=

# --- Obsidian PKM Vault (L0-L4 Memory Protocols) ---
# Target vault directory. In Docker, mount your host vault to /app/vault.
OBSIDIAN_VAULT_DIR=/app/vault
