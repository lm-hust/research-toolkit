# ==============================================================================
# Research Toolkit Environment Configuration
# Copy this file to .env and populate your secrets.
# ==============================================================================

# --- Zotero Integration (Personal Library, ADR-0002) ---
# Your personal numerical Zotero User ID (found at https://www.zotero.org/settings/keys)
ZOTERO_USER_ID=

# Your Zotero Web API Key (create at https://www.zotero.org/settings/keys with Read/Write permissions)
ZOTERO_API_KEY=

# --- Literature Discovery APIs ---
# Semantic Scholar API key (recommended to avoid HTTP 429 public pool rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex API key (free registered developer key; grants higher RPS)
OPENALEX_API_KEY=

# --- Google NotebookLM Gateway ---
# Android master token 存放在 ~/.notebooklm/profiles/<profile>/master_token.json（权限 600），
# 不要放进环境变量。notebooklm-py 把 NOTEBOOKLM_AUTH_JSON 当作浏览器 cookie 登录状态
# （{"cookies": [...]}）读取，并优先于 master token 生效；填入 master token JSON 会阻断登录。
NOTEBOOKLM_BACKEND=android

# --- Dual-Stack Gateway & Ingress (ADR-0006) ---
# Secret API Key required for ChatGPT Actions and Claude MCP SSE authorization
RESEARCH_TOOLKIT_API_KEY=your_secret_api_key_here

# Your DuckDNS domain (e.g. ling-research.duckdns.org) for automated Caddy HTTPS
DUCKDNS_DOMAIN=your_subdomain.duckdns.org

# --- Obsidian PKM Vault (L0-L4 Memory Protocols) ---
# Target vault directory. In Docker, mount your host vault to /app/vault.
OBSIDIAN_VAULT_DIR=/app/vault

